generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENT
  CUSTOMER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Status {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum MessageType {
  CUSTOMER_REPLY
  AGENT_REPLY
  INTERNAL_NOTE
}

enum ActivityAction {
  TICKET_CREATED
  STATUS_UPDATED
  PRIORITY_UPDATED
  AGENT_ASSIGNED
  INTERNAL_NOTE_ADDED
  CUSTOMER_REPLIED
  AGENT_REPLIED
  TICKET_RESOLVED
  TICKET_CLOSED
  TICKET_REOPENED
}

enum NotificationType {
  TICKET_ASSIGNED
  NEW_REPLY
  STATUS_CHANGED
  SLA_WARNING
  OVERDUE_ALERT
  SYSTEM
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(CUSTOMER)
  avatarUrl    String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  customerTickets Ticket[]        @relation("CustomerTickets")
  assignedTickets Ticket[]        @relation("AssignedTickets")
  messages        TicketMessage[]
  activities      TicketActivity[]
  notifications   Notification[]
  refreshTokens   RefreshToken[]

  @@index([role])
  @@index([email])
}

model Ticket {
  id              String    @id @default(uuid())
  ticketNumber    String    @unique
  subject         String
  description     String
  category        String    @default("General")
  priority        Priority  @default(MEDIUM)
  status          Status    @default(OPEN)
  
  customerId      String
  customer        User      @relation("CustomerTickets", fields: [customerId], references: [id], onDelete: Cascade)

  assignedAgentId String?
  assignedAgent   User?     @relation("AssignedTickets", fields: [assignedAgentId], references: [id], onDelete: SetNull)

  dueDate         DateTime?
  slaDeadline     DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  messages        TicketMessage[]
  activities      TicketActivity[]

  @@index([ticketNumber])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([customerId])
  @@index([assignedAgentId])
  @@index([createdAt])
  @@index([slaDeadline])
}

model TicketMessage {
  id          String      @id @default(uuid())
  ticketId    String
  ticket      Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  senderId    String
  sender      User        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  messageType MessageType @default(CUSTOMER_REPLY)
  body        String
  isInternal  Boolean     @default(false)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([ticketId])
  @@index([senderId])
  @@index([isInternal])
  @@index([createdAt])
}

model TicketActivity {
  id        String         @id @default(uuid())
  ticketId  String
  ticket    Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  action    ActivityAction
  details   Json?

  createdAt DateTime       @default(now())

  @@index([ticketId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  type      NotificationType @default(SYSTEM)

  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model RefreshToken {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt  DateTime
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
}
