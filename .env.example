# Environment Configuration for HelpDesk

# Backend Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://helpdesk:helpdesk_secret@localhost:5432/helpdesk_db?schema=public

# Redis Configuration (Optional in development - app falls back to in-memory)
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets
JWT_ACCESS_SECRET=helpdesk_super_secret_access_jwt_key_2026_dev_mode
JWT_REFRESH_SECRET=helpdesk_super_secret_refresh_jwt_key_2026_dev_mode
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Client URL
CORS_ORIGIN=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000
